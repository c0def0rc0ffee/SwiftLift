DB_HOST=localhost
DB_NAME=swiftlift
DB_USER=swiftlift
DB_PASS=changeme
SESSION_NAME=swiftlift_sid

# Show detailed error info in API JSON responses (class, file, line).
# Leave 0 for production; set to 1 when debugging on the live server.
APP_DEBUG=0

# Maintenance mode. Set to 1 to take the site offline politely: every
# API call (except /api/__ping and /api/health) returns 503 with a
# maintenance flag, and the SPA renders a "back in a moment" page that
# auto-reloads every 30s. Flip back to 0 (or remove) to bring it live.
MAINTENANCE_MODE=0
MAINTENANCE_MESSAGE=

# REQUIRED to install or re-run setup.php. It must match the ?token=...
# URL parameter: without a token, /setup.php returns 403. Use a long
# random string. After setup is done, delete setup.php from the webroot.
SETUP_TOKEN=change-me-to-a-long-random-string

# RECOMMENDED. Two paths into /admin.php:
#   1. ?token=<ADMIN_TOKEN>: works even if no admin user can log in,
#      so this is your break-glass recovery path.
#   2. Sign in as a user with users.is_admin = 1 (set via the bootstrap
#      flow described in DEPLOY.md).
# Anyone with the URL containing the token can view the dashboard, so
# treat it like a password.
ADMIN_TOKEN=change-me-to-a-different-long-random-string

# Outbound email (used for signup verification + password reset).
MAIL_FROM=hello@swiftlift.gg
MAIL_FROM_NAME=SwiftLift

# When mail() returns false the message is dropped: body is NOT
# written to disk (avoids leaking verify/reset tokens in .eml files).
# Set to 1 ONLY on a local dev box where you want to see what would
# have been sent (written to storage/outbox/). Never enable in prod.
MAIL_DEV_OUTBOX=0

# REQUIRED. Public base URL (scheme + host) used to build links in
# outbound emails (verify, password reset) and OAuth callbacks. Must be
# set: leaving it blank used to let attackers inject a Host header into
# /api/auth/forgot to redirect the password-reset email to their own
# domain, leaking the reset token in the URL.
#   Production:  APP_BASE_URL=https://swiftlift.gg
#   Local dev:   APP_BASE_URL=http://swiftlift
APP_BASE_URL=https://swiftlift.gg

# Facebook OAuth (optional). Both must be set for the "Continue with
# Facebook" button to appear on the login screen.
#   1. Create an app at https://developers.facebook.com
#   2. Add the "Facebook Login" product
#   3. Set the Valid OAuth Redirect URI to:
#        https://swiftlift.gg/api/index.php?p=auth/oauth/facebook/callback
#      (your APP_BASE_URL above + /api/index.php?p=auth/oauth/facebook/callback)
#   4. Copy the App ID + App Secret from Settings → Basic.
#   5. To get user emails (highly recommended), submit the app for "email"
#      permission in App Review. Test users / app admins can use it before review.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google Sign-In (optional). Both must be set for the "Continue with
# Google" button to appear on the login screen.
#   1. Google Cloud Console → APIs & Services → Credentials
#   2. Create an "OAuth 2.0 Client ID" of type "Web application"
#   3. Authorised redirect URI:
#        https://swiftlift.gg/api/index.php?p=auth/oauth/google/callback
#   4. Copy the Client ID + Client Secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
